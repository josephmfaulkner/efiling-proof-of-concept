{
  "formId": "i-130",
  "rules": [
    {
      "name": "revealPreparerInterpreterSubQuestions",
      "conditions": { "all": [{ "fact": "hasHelper", "operator": "equal", "value": "Y" }] },
      "event": { "type": "showField", "params": { "fieldNames": ["helperHasPreparer", "helperHasInterpreter"] } }
    },
    {
      "name": "showPreparerInformationStep",
      "conditions": { "all": [{ "fact": "helperHasPreparer", "operator": "equal", "value": "Y" }] },
      "event": { "type": "showStep", "params": { "stepIds": ["preparer-information"] } }
    },
    {
      "name": "showInterpreterInformationStep",
      "conditions": { "all": [{ "fact": "helperHasInterpreter", "operator": "equal", "value": "Y" }] },
      "event": { "type": "showStep", "params": { "stepIds": ["interpreter-information"] } }
    },
    {
      "name": "revealYourOtherNameFields",
      "conditions": { "all": [{ "fact": "hasUsedOtherNames", "operator": "equal", "value": "Y" }] },
      "event": { "type": "showField", "params": { "fieldNames": ["otherNameFirstName", "otherNameMiddleName", "otherNameLastName"] } }
    },
    {
      "name": "showYourUsCitizenInformationStep",
      "conditions": { "all": [{ "fact": "immigrationStatus", "operator": "equal", "value": "citizen" }] },
      "event": { "type": "showStep", "params": { "stepIds": ["your-us-citizen-information", "proof-of-citizenship"] } }
    },
    {
      "name": "showYourLawfulPermanentResidentInformationStep",
      "conditions": { "all": [{ "fact": "immigrationStatus", "operator": "equal", "value": "lpr" }] },
      "event": { "type": "showStep", "params": { "stepIds": ["your-lawful-permanent-resident-information", "proof-of-lpr-status"] } }
    },
    {
      "name": "revealNaturalizationCertificateFields",
      "conditions": { "all": [{ "fact": "hasNaturalizationCertificate", "operator": "equal", "value": "Y" }] },
      "event": { "type": "showField", "params": { "fieldNames": ["certificateNumber", "certificateIssuancePlace", "certificateIssuanceDate"] } }
    },
    {
      "name": "showCurrentSpouseStep",
      "conditions": { "all": [{ "fact": "maritalStatus", "operator": "equal", "value": "married" }] },
      "event": { "type": "showStep", "params": { "stepIds": ["current-spouse"] } }
    },
    {
      "name": "showPriorMarriagesStep",
      "conditions": { "all": [{ "fact": "maritalStatus", "operator": "notEqual", "value": "single" }] },
      "event": { "type": "showStep", "params": { "stepIds": ["prior-marriages", "evidence-end-of-your-prior-marriage"] } }
    },
    {
      "name": "showAddressesLivedTogetherStep",
      "conditions": { "all": [{ "fact": "filingPetitionFor", "operator": "equal", "value": "spouse" }] },
      "event": {
        "type": "showStep",
        "params": {
          "stepIds": ["addresses-lived-together", "proof-of-marriage", "photo-of-spouse", "additional-proof-of-marriage", "i130a"]
        }
      }
    },
    {
      "name": "showImmigrationProceedingsStep",
      "conditions": { "all": [{ "fact": "beneficiaryHasBeenInImmigrationProceedings", "operator": "equal", "value": "Y" }] },
      "event": { "type": "showStep", "params": { "stepIds": ["immigration-proceedings"] } }
    },
    {
      "name": "showPriorSpousesStep",
      "conditions": { "all": [{ "fact": "beneficiaryMaritalStatus", "operator": "notEqual", "value": "single" }] },
      "event": { "type": "showStep", "params": { "stepIds": ["prior-spouses", "evidence-end-of-spouses-prior-marriage"] } }
    },
    {
      "name": "revealPriorPetitionDetailFields",
      "conditions": { "all": [{ "fact": "previouslyFiledPetition", "operator": "equal", "value": "Y" }] },
      "event": {
        "type": "showField",
        "params": {
          "fieldNames": [
            "priorPetitionBeneficiaryFirstName",
            "priorPetitionBeneficiaryMiddleName",
            "priorPetitionBeneficiaryLastName",
            "priorPetitionCity",
            "priorPetitionState",
            "priorPetitionDate",
            "priorPetitionResult"
          ]
        }
      }
    }
  ]
}
